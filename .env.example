# Database URL (SQLite for local zero-config, PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# Application Engine Configuration
NEXT_PUBLIC_ENGINE_VERSION="1.0.0"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Sentry Error Telemetry (Optional - Safe No-Op if empty)
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
SENTRY_RELEASE="1.0.0"

# PostHog Product Analytics (Optional - Safe No-Op if empty)
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
NEXT_PUBLIC_ANALYTICS_DEBUG="false"

# Result Snapshot Signing Secret
RESULT_SIGNING_SECRET="cbs_signing_secret_dev_2026"

# Server Logging Level
LOG_LEVEL="info"
